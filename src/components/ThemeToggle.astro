---
const sizes = {
  sm: {
    track: 'h-5 w-9',
    thumb: 'h-3 w-3 translate-x-1 dark:translate-x-5',
    icon: 'h-2.5 w-2.5',
  },
  md: {
    track: 'h-6 w-11',
    thumb: 'h-4 w-4 translate-x-1 dark:translate-x-6',
    icon: 'h-3 w-3',
  },
  lg: {
    track: 'h-8  w-14',
    thumb: 'h-6 w-6 translate-x-1 dark:translate-x-7',
    icon: 'h-4 w-4',
  },
}

const {
  size = 'md',
  transitionDuration = 150,
} = Astro.props

const s = sizes[size] || sizes.md;
---

<button id="theme-toggle" class="rounded-full cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-600 p-0 inline-flex" aria-label="Toggle dark mode" title="Toggle dark mode">
    <!-- The Track -->
    <span class={`bg-line dark:bg-ink-muted relative inline-flex items-center rounded-full transition-colors ${s.track} p-0`} style={`transition-duration: ${transitionDuration}ms`}>
        <!-- Sun / Moon icons -->
        <span class="absolute inset-0 flex items-center justify-between px-2 text-black" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class={s.icon}>
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class={s.icon}>
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 12 21.75a9.753 9.753 0 0 0 9.752-6.748Z" />
            </svg>
        </span>
        <!-- The Thumb -->
        <span class={`relative rounded-full bg-white dark:bg-black transition-transform ${s.thumb}`} style={`transition-duration: ${transitionDuration}ms`}></span>
    </span>
</button>

<script>
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('themeMode', isDark ? 'dark' : 'light');
    })
</script>
