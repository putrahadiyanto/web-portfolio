---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../data/site-config";
---

<header id="top" class="fixed top-0 inset-x-0 z-50 border-b border-line bg-background/80 backdrop-blur">
  <nav class="flex h-20 items-center px-4" aria-label="Main navigation">
    <div class="mx-auto flex w-full max-w-5xl justify-end">
      <div class="hidden items-center gap-6 md:flex">
        {siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="text-md text-ink-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
    <div class="ml-6 shrink-0">
      <ThemeToggle size="lg" />
    </div>
  </nav>
  <div class="border-t border-line md:hidden">
    <nav class="mx-auto flex max-w-5xl items-center gap-5 overflow-x-auto px-4 py-2" aria-label="Mobile navigation">
      {siteConfig.nav.map((item) => (
        <a href={item.href} class="whitespace-nowrap text-sm text-ink-muted hover:text-ink">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
