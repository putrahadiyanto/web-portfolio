---
import { skillGroups } from "../data/site-config";

const skillIconMap: Record<string, string> = {
  Python: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
  SQL: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mysql/mysql-original.svg",
  Java: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg",
  C: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/c/c-original.svg",
  PyTorch: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pytorch/pytorch-original.svg",
  YOLO: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pytorch/pytorch-original.svg",
  "Vision Transformer": "https://cdn.simpleicons.org/pytorch/EE4C2C",
  Transformers: "https://cdn.simpleicons.org/huggingface/FFD21E",
  LangChain: "https://cdn.simpleicons.org/langchain",
  "Apache Airflow": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apacheairflow/apacheairflow-original.svg",
  FastAPI: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg",
  MongoDB: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg",
  "REST APIs": "https://cdn.simpleicons.org/fastapi/009688",
  Docker: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg",
  Git: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg",
  Selenium: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/selenium/selenium-original.svg",
  Appium: "https://cdn.simpleicons.org/appium/367145",
};
---

<section id="skills" class="border-t border-line bg-background">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <!-- Header -->
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-medium tracking-widest text-ink-muted uppercase">Skills</p>
      <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        Technologies I work with
      </h2>
      <p class="mt-4 text-[15px] leading-7 text-ink-muted">
        Focused on practical stacks for deep learning, data pipelines, and backend systems. Clean, production-ready tooling.
      </p>
    </div>

    <!-- Groups -->
    <div class="mt-10 grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        skillGroups.map((group) => (
          <div class="rounded-lg bg-surface p-6">
            <h3 class="text-sm font-semibold tracking-wide text-ink">{group.label}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="inline-flex items-center gap-1.5 rounded-full bg-background px-3 py-1 text-sm text-ink">
                  {skillIconMap[skill] && (
                    <img
                      src={skillIconMap[skill]}
                      alt=""
                      aria-hidden="true"
                      class="h-4 w-4 object-contain"
                      loading="lazy"
                      width="16"
                      height="16"
                    />
                  )}
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
