---
import { experience } from "../data/site-config";
import internImg from "../assets/intern.jpeg";
import asprakImg from "../assets/asprak.jpeg";

const images = [internImg, asprakImg];
---

<section id="experience" class="border-t border-line bg-surface">
  <div class="mx-auto max-w-5xl px-4 py-16 md:py-24">
    <!-- Header -->
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-medium tracking-widest text-ink-muted uppercase">Experience</p>
      <h2 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Where I've worked</h2>
      <p class="mt-4 text-[15px] leading-7 text-ink-muted">
        Internship and lab work focused on QA automation, ETL review, and mentoring.
      </p>
    </div>

    <!-- Timeline -->
    <div class="mt-10 grid gap-6">
      {
        experience.map((item, idx) => (
          <article class="overflow-hidden rounded-lg bg-background">
            <div class="grid md:grid-cols-[1.1fr_1.9fr]">
              <div class="relative aspect-[4/3] overflow-hidden bg-surface md:aspect-[4/3]">
                <img
                  src={images[idx].src}
                  alt={item.org}
                  width={images[idx].width}
                  height={images[idx].height}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-6 sm:p-8">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <h3 class="text-lg font-semibold leading-6 text-ink">{item.role}</h3>
                    <p class="mt-1 text-sm font-medium text-ink">{item.org}</p>
                  </div>
                  <span class="shrink-0 rounded-full bg-surface px-3 py-1 text-xs font-medium text-ink-muted">
                    {item.period}
                  </span>
                </div>
                <ul class="mt-4 space-y-2">
                  {item.points.map((pt) => (
                    <li class="flex gap-2 text-sm leading-6 text-ink-muted">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-muted"></span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
