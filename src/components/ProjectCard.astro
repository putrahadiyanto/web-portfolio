---
import type { ProjectPreview } from "../data/site-config";
import { projectImages } from "../data/project-images";

interface Props {
  project: ProjectPreview;
}

const { project } = Astro.props;
const preview = projectImages[project.slug];

const techIconMap: Record<string, string> = {
  Python: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg",
  PyTorch: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/pytorch/pytorch-original.svg",
  "Vision Transformer": "https://cdn.simpleicons.org/pytorch/EE4C2C",
  "Audio Transformer": "https://cdn.simpleicons.org/pytorch/EE4C2C",
  FastAPI: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg",
  LangChain: "https://cdn.simpleicons.org/langchain",
  MongoDB: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg",
  Docker: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg",
  "Apache Airflow": "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apacheairflow/apacheairflow-original.svg",
  Transformers: "https://cdn.simpleicons.org/huggingface/FFD21E",
  "REST APIs": "https://cdn.simpleicons.org/fastapi/009688",
};
---

<article class="group flex flex-col overflow-hidden rounded-lg bg-surface">
  {preview && (
    <a href={`/projects/${project.slug}`} class="block overflow-hidden" aria-label={project.title}>
      <img
        src={preview.src}
        alt={project.title}
        width={preview.width}
        height={preview.height}
        class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-lg font-semibold leading-6 text-ink">
      <a href={`/projects/${project.slug}`} class="hover:underline underline-offset-4">
        {project.title}
      </a>
    </h3>
    <p class="mt-3 text-sm leading-6 text-ink-muted">
      {project.description}
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      {
        project.techStack.map((tech) => (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-background px-2.5 py-1 text-xs font-medium text-ink">
            {techIconMap[tech] && (
              <img
                src={techIconMap[tech]}
                alt=""
                aria-hidden="true"
                class="h-3.5 w-3.5 object-contain"
                loading="lazy"
                width="14"
                height="14"
              />
            )}
            {tech}
          </span>
        ))
      }
    </div>

    <div class="mt-6 flex items-center gap-4 border-t border-gray-100 pt-4">
      <a
        href={project.github}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-ink transition-opacity hover:opacity-70"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.165c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.468-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M17 7H8m9 0v9"/>
        </svg>
      </a>
      <a
        href={`/projects/${project.slug}`}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors hover:text-ink"
      >
        Details
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-3.5 w-3.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>
  </div>
</article>
