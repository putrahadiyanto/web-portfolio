---
import '../styles/global.css'
import { siteConfig } from '../data/site-config';
import photo from '../assets/photo.jpg';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${siteConfig.name} — ${siteConfig.title}`,
  description = siteConfig.description,
  image = photo.src,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImage = new URL(image, siteConfig.url).href;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<script is:inline>
          (() => {
            const savedThemeMode = localStorage.getItem('themeMode') || 'dark';
            document.documentElement.classList.toggle('dark', savedThemeMode === 'dark');
          })();
        </script>
	</head>
	<body class="bg-background text-ink font-sans pt-20">
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
